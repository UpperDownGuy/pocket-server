# Leave HOST at 127.0.0.1 for local use. Set your LAN IP for iPhone testing.
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/pocket.sqlite
# Docker publishes only to this host interface. Keep loopback when a reverse
# proxy on this machine terminates HTTPS. For private-LAN testing, set the
# machine's LAN IP and allow that port through your firewall.
POCKET_BIND_ADDRESS=127.0.0.1
POCKET_PORT=8787
# Optional: otherwise a random one-time code prints at startup while unconfigured.
# SETUP_CODE=
# Optional Apple Push Notifications; never commit your .p8 key.
# TestFlight, App Store and ad hoc installs use production. Local Xcode development uses sandbox.
# APNS_ENVIRONMENT=production
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_TOPIC=YOUR_SIGNED_APP_BUNDLE_ID
# APNS_KEY_PATH=/run/pocket-apns/AuthKey.p8
